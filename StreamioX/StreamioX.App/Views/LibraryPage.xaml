<Page
    x:Class="StreamioX.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <Grid Padding="48,27,48,27">
        <StackPanel Spacing="16">
            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="36" FontWeight="SemiBold"/>
            <TextBlock Text="Your library is currently empty." Foreground="{StaticResource TextSecondaryBrush}" FontSize="18"/>
        </StackPanel>
    </Grid>
</Page>