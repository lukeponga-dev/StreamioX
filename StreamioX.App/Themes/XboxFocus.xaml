<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared high-contrast focus treatment for controller-operated controls. -->
    <Style x:Key="XboxFocusCardStyle" TargetType="Control">
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="#16C60C" />
        <Setter Property="FocusVisualPrimaryThickness" Value="3" />
        <Setter Property="FocusVisualSecondaryBrush" Value="#16C60C" />
        <Setter Property="FocusVisualSecondaryThickness" Value="1" />
    </Style>

    <Style x:Key="XboxFocusVisualStyle" TargetType="Control"
           BasedOn="{StaticResource XboxFocusCardStyle}" />
</ResourceDictionary>
