<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Colors -->
    <Color x:Key="SurfaceBase">#05090C</Color>
    <Color x:Key="SurfaceCard">#0B1217</Color>
    <Color x:Key="SurfaceHover">#141D24</Color>
    <Color x:Key="SurfaceSelected">#1A272F</Color>

    <!-- Accent Colors -->
    <Color x:Key="AccentGreen">#20E66B</Color>
    <Color x:Key="AccentCyan">#00D9C0</Color>
    <Color x:Key="ErrorRed">#E74C3C</Color>
    <Color x:Key="WarningOrange">#F39C12</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#A0ADB3</Color>
    <Color x:Key="TextTertiary">#6B7980</Color>
    <Color x:Key="BorderDefault">#26333B</Color>

    <!-- Brushes - Surfaces -->
    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{StaticResource SurfaceBase}"/>
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCard}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHover}"/>
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{StaticResource SurfaceSelected}"/>

    <!-- Brushes - Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentGreen}"/>
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorRed}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningOrange}"/>

    <!-- Brushes - Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefault}"/>

    <!-- Legacy Compatibility -->
    <Color x:Key="ObsidianBase">#05090C</Color>
    <Color x:Key="ObsidianSurface">#0B1217</Color>
    <Color x:Key="PlasmaViolet">#20E66B</Color>
    <Color x:Key="IonBlue">#00D9C0</Color>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource SurfaceBase}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceCard}"/>
    <SolidColorBrush x:Key="FocusAccentBrush" Color="{StaticResource AccentGreen}"/>
</ResourceDictionary>
