<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ObsidianBase">#05090C</Color>
    <Color x:Key="ObsidianSurface">#0B1217</Color>
    <Color x:Key="PlasmaViolet">#20E66B</Color>
    <Color x:Key="IonBlue">#00D9C0</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#A0ADB3</Color>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource ObsidianBase}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ObsidianSurface}"/>
    <SolidColorBrush x:Key="FocusAccentBrush" Color="{StaticResource PlasmaViolet}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
</ResourceDictionary>