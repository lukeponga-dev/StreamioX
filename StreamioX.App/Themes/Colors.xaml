<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ObsidianBase">#05060A</Color>
    <Color x:Key="ObsidianSurface">#0B0D17</Color>
    <Color x:Key="PlasmaViolet">#7B5CFF</Color>
    <Color x:Key="IonBlue">#00E5FF</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#A0A4B8</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource ObsidianBase}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ObsidianSurface}" />
    <SolidColorBrush x:Key="FocusAccentBrush" Color="{StaticResource PlasmaViolet}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
</ResourceDictionary>