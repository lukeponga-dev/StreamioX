<!-- Purpose: Defines the reusable MediaCardControl control template and visual states. -->
<UserControl
    x:Class="StreamioX.App.Controls.MediaCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="False"
    GotFocus="MediaCardControl_GotFocus"
    LostFocus="MediaCardControl_LostFocus">

    <Grid
        x:Name="RootGrid"
        Width="200"
        Height="300"
        Background="#252535"
        RenderTransformOrigin="0.5,0.5">

        <Grid.RenderTransform>
            <ScaleTransform
                x:Name="CardScale"
                ScaleX="1"
                ScaleY="1"/>
        </Grid.RenderTransform>

        <Image
            Source="{Binding PosterUrl}"
            Stretch="UniformToFill"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"/>

        <Border
            VerticalAlignment="Bottom"
            Background="#E605060A"
            Padding="10,12">

            <StackPanel Spacing="4">
                <TextBlock
                    Text="{Binding Title}"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    MaxLines="2"/>

                <TextBlock
                    Text="{Binding Type}"
                    Foreground="#A99AFF"
                    FontSize="12"/>
            </StackPanel>
        </Border>

        <Border
            x:Name="GlowBorder"
            BorderBrush="#7B5CFF"
            BorderThickness="3"
            Visibility="Collapsed"
            IsHitTestVisible="False"/>
    </Grid>
</UserControl>