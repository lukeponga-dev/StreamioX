<!-- Purpose: Defines the reusable HeroBannerControl control template and visual states. -->
<UserControl
    x:Class="StreamioX.App.Controls.HeroBannerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="False">

    <Grid Height="380" CornerRadius="12" Margin="0,0,0,24">
        <!-- Backdrop Image Layer -->
        <Border CornerRadius="12">
            <Image Source="{Binding FeaturedMovie.PosterUrl}" 
                   Stretch="UniformToFill" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
        </Border>

        <!-- Gradient Overlay for Contrast and Nebula Noir Aesthetic -->
        <Border CornerRadius="12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#FF05060A" Offset="0.0"/>
                    <GradientStop Color="#E605060A" Offset="0.4"/>
                    <GradientStop Color="#3305060A" Offset="0.8"/>
                    <GradientStop Color="#0005060A" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Vertical Bottom Gradient Overlay -->
        <Border CornerRadius="12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#0005060A" Offset="0.5"/>
                    <GradientStop Color="#FF05060A" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Content Overlay Container -->
        <Grid Padding="40" VerticalAlignment="Bottom">
            <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">

                <!-- Category Badge -->
                <Border Background="{StaticResource FocusAccentBrush}" 
                        CornerRadius="4" 
                        Padding="8,4" 
                        HorizontalAlignment="Left">
                    <TextBlock Text="FEATURED" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="12" 
                               FontWeight="Bold"/>
                </Border>

                <!-- Media Title -->
                <TextBlock Text="{Binding FeaturedMovie.Title}" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           FontSize="38" 
                           FontWeight="Bold" 
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>

                <!-- Release Info / Description -->
                <TextBlock Text="{Binding FeaturedMovie.Description}" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           FontSize="15" 
                           TextTrimming="CharacterEllipsis" 
                           MaxLines="3" 
                           LineHeight="22"/>

                <!-- Action Button for Xbox Controller Selection -->
                <Button Command="{Binding PlayFeaturedCommand}"
                        Background="{StaticResource FocusAccentBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Padding="24,12"
                        CornerRadius="6"
                        Margin="0,8,0,0"
                        XYFocusKeyboardNavigation="Enabled">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE768;" FontSize="16"/>
                        <TextBlock Text="Watch Now" FontWeight="SemiBold" FontSize="16"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>