<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <UseUwp>true</UseUwp>
    <Platforms>x86;x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableMsixTooling>true</EnableMsixTooling>
    <BuildTorrentBridge Condition="'$(BuildTorrentBridge)' == ''">true</BuildTorrentBridge>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="Converters\" />
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)' == 'x64'">
    <!-- Include the native bridge even on a clean checkout; BuildTorrentBridge creates it before content is copied. -->
    <Content Include="..\native\torrent-bridge\target\x86_64-uwp-windows-msvc\release\streamio_torrent_bridge.dll" Link="streamio_torrent_bridge.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildTorrentBridge" BeforeTargets="PrepareForBuild" Condition="'$(Platform)' == 'x64' and '$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(BuildTorrentBridge)' != 'false'">
    <Exec Command="cargo +nightly build -Z build-std=std,panic_unwind --manifest-path &quot;$(MSBuildProjectDirectory)\..\native\torrent-bridge\Cargo.toml&quot; --target x86_64-uwp-windows-msvc --release" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.UI.Xaml" Version="2.8.7" />
    <PackageReference Include="FFmpegInteropX.UWP" Version="2.1.0.81200" />
  </ItemGroup>
</Project>
