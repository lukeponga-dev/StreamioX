<Page
    x:Class="StreamioX.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:layout="using:StreamioX.App.Layout"
    XYFocusKeyboardNavigation="Enabled"
    Background="#05060A">

    <Page.Resources>
        <!-- Solid Colors for Performance over Transparency -->
        <SolidColorBrush x:Key="ObsidianBaseBrush" Color="#05060A" />
        <SolidColorBrush x:Key="ObsidianSurfaceBrush" Color="#0B0D17" />
        <SolidColorBrush x:Key="PlasmaVioletBrush" Color="#7B5CFF" />

        <!-- Override NavigationView resources to match Nebula Noir theme -->
        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0B0D17" />
        <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0B0D17" />
        <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#7B5CFF" />
    </Page.Resources>

    <Grid Padding="{x:Bind layout:XboxConstants.SafeArea}">
        <NavigationView x:Name="NavShell"
                        PaneDisplayMode="Left"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        AlwaysShowHeader="False"
                        XYFocusKeyboardNavigation="Enabled"
                        ItemInvoked="NavShell_ItemInvoked">

            <!-- Primary Navigation Destinations -->
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavItem"
                                    Content="Home" 
                                    Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Discover" Tag="Discover">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Library" Tag="Library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Add-ons" Tag="Addons">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE718;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Player" Tag="Player">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE714;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Diagnostic" Tag="Diagnostic">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Bottom Menu Items for Settings -->
     

            <!-- Content Area managed by INavigationService -->
            <Frame x:Name="ContentFrame" XYFocusKeyboardNavigation="Enabled" />
        </NavigationView>
    </Grid>
</Page>