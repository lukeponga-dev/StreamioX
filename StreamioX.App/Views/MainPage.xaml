<Page
    x:Class="StreamioX.App.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:layout="using:StreamioX.App.Layout"
    XYFocusKeyboardNavigation="Enabled"
    Background="#05090C">
    <Grid Padding="{x:Bind layout:XboxConstants.SafeArea}">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#05090C" Offset="0"/>
                <GradientStop Color="#07130F" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <NavigationView x:Name="NavShell" PaneDisplayMode="Top" PaneTitle="STREAMIOX"
                        IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        AlwaysShowHeader="False" Background="#05090C"
                        XYFocusKeyboardNavigation="Enabled" ItemInvoked="NavShell_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeNavItem" Content="Home" Tag="Home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Discover" Tag="Discover">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71C;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Search" Tag="Search">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Library" Tag="Library">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Add-ons" Tag="Addons">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE718;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" XYFocusKeyboardNavigation="Enabled"/>
        </NavigationView>

        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,14,0"
                Padding="10,5" Background="#101A20" BorderBrush="#244238" BorderThickness="1"
                XYFocusKeyboardNavigation="Enabled">
            <StackPanel Orientation="Horizontal" Spacing="9">
                <Border Width="30" Height="30" CornerRadius="15" Background="#173C2A" BorderBrush="#20E66B" BorderThickness="1">
                    <FontIcon Glyph="&#xE77B;" Foreground="#B9FFD0" FontSize="17"/>
                </Border>
                <TextBlock x:Name="ProfileNameText" Text="Sign In" Foreground="White" VerticalAlignment="Center" FontSize="14"/>
                <TextBlock Text="⌄" Foreground="#A0ADB3" VerticalAlignment="Center"/>
            </StackPanel>
            <Button.Flyout>
                <Flyout Placement="Bottom">
                    <Border Width="220" Padding="14" Background="#0C1419">
                        <StackPanel Spacing="9">
                            <TextBlock x:Name="FlyoutProfileNameText" Text="Sign In" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="STREAMIOX PROFILE" Foreground="#91A29A" FontSize="11"/>
                            <Rectangle Height="1" Fill="#263B33"/>
                            <Button Content="My Library" HorizontalAlignment="Stretch" Click="ProfileLibrary_Click"/>
                            <Button Content="Add-ons" HorizontalAlignment="Stretch" Click="ProfileAddons_Click"/>
                            <Button Content="Settings" HorizontalAlignment="Stretch" Click="ProfileSettings_Click"/>
                            <Button Content="Diagnostics" HorizontalAlignment="Stretch" Click="ProfileDiagnostics_Click"/>
                            <Button Content="About StreamioX" HorizontalAlignment="Stretch" Click="ProfileAbout_Click"/>
                        </StackPanel>
                    </Border>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</Page>