<Page
    x:Class="StreamioX.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#05060A">
    <Grid Padding="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,20">
            <TextBlock Text="Search" Foreground="White" FontSize="34" FontWeight="SemiBold"/>
            <TextBlock Text="Find movies and series across your installed catalog add-ons."
                       Foreground="#A9A5B8" FontSize="16"/>
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchInput" Grid.Column="0" Height="54"
                     PlaceholderText="Search titles..."
                     FontSize="20" VerticalContentAlignment="Center"
                     Background="#171827" Foreground="White"
                     BorderBrush="#51466F" KeyDown="SearchInput_KeyDown"/>
            <Button x:Name="SearchButton" Grid.Column="1" Content="SEARCH"
                    Height="54" FontSize="16" FontWeight="SemiBold"
                    Background="#7B5CFF" Foreground="White"
                    Click="SearchButton_Click"/>
        </Grid>
        <ScrollViewer x:Name="ResultsScroll" Grid.Row="2"
                      VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" Background="Transparent">
            <StackPanel x:Name="ResultsRowsPanel" Orientation="Vertical" Spacing="12"/>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="3" Text="Enter a title to search."
                   Foreground="#A9A5B8" FontSize="14" Margin="0,14,0,0"/>
    </Grid>
</Page>