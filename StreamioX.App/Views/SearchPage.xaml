<Page
    x:Class="StreamioX.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">
    <Grid Padding="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,18">
            <TextBlock Text="Search" Foreground="White" FontSize="34" FontWeight="SemiBold"/>
            <TextBlock Text="Find movies and series across your installed catalog add-ons." Foreground="#A9A5B8" FontSize="16"/>
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchInput" Grid.Column="0" Height="58" PlaceholderText="Search movies and series..."
                     FontSize="20" VerticalContentAlignment="Center" Background="#171827" Foreground="White"
                     BorderBrush="#51466F" KeyDown="SearchInput_KeyDown" TextChanged="SearchInput_TextChanged"/>
            <Button x:Name="SearchButton" Grid.Column="1" Content="SEARCH" Height="58" FontSize="16"
                    FontWeight="SemiBold" Background="#7B5CFF" Foreground="White" Click="SearchButton_Click"/>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,14">
            <TextBlock Text="Recent searches" Foreground="#B9B2D0" FontSize="14"/>
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                <StackPanel x:Name="RecentSearchesPanel" Orientation="Horizontal" Spacing="8"/>
            </ScrollViewer>
        </StackPanel>
        <ScrollViewer x:Name="ResultsScroll" Grid.Row="3" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" Background="Transparent">
            <StackPanel x:Name="ResultsRowsPanel" Orientation="Vertical" Spacing="12"/>
        </ScrollViewer>
        <TextBlock x:Name="StatusText" Grid.Row="4" Text="Start typing to search your installed catalogs."
                   Foreground="#A9A5B8" FontSize="14" Margin="0,12,0,0"/>
    </Grid>
</Page>