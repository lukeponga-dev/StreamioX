<Page
    x:Class="StreamioX.App.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#05060A"
    XYFocusKeyboardNavigation="Enabled">
    <Grid Padding="48">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" MaxWidth="720">
            <TextBlock Text="StreamioX Diagnostics" Foreground="White" FontSize="32" FontWeight="Bold"/>
            <TextBlock Text="Playback verification" Foreground="#A1A1AA" FontSize="18"/>
            <TextBlock Text="Launch a public-domain sample video through the same FFmpegInteropX pipeline used by Stremio streams. This temporary test uses a direct HTTPS MP4 and does not contact torrent providers."
                       Foreground="#A1A1AA" FontSize="15" TextWrapping="Wrap"/>
            <Button Content="Play authenticated Jackettio add-on test (The Matrix)"
                    Click="PlayAuthenticatedAddon_Click"
                    HorizontalAlignment="Left"
                    Padding="24,14"
                    Background="#174C3A"
                    Foreground="White"
                    FontSize="17"/>
            <Button Content="Play Big Buck Bunny test video"
                    Click="PlayBigBuckBunny_Click"
                    HorizontalAlignment="Left"
                    Padding="24,14"
                    Background="#7B5CFF"
                    Foreground="White"
                    FontSize="17"/>
            <Button Content="Play Big Buck Bunny torrent test"
                    Click="PlayBigBuckBunnyTorrent_Click"
                    HorizontalAlignment="Left"
                    Padding="24,14"
                    Background="#29243F"
                    Foreground="White"
                    FontSize="17"/>
            <TextBlock Text="Torrent test: local librqbit seeder on TCP 50000; verifies peer discovery, metadata, automatic file selection and HTTP byte ranges."
                       Foreground="#737B8C" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="Source: Big Buck Bunny 720p H.264 MP4 sample (10 seconds)"
                       Foreground="#737B8C" FontSize="12"/>
        </StackPanel>
    </Grid>
</Page>