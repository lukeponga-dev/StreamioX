<!-- Views/PlayerPage.xaml -->
<Page
    x:Class="StreamioX.App.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#05060A"
    XYFocusKeyboardNavigation="Enabled">

    <Grid>
        <!-- Native UWP MediaPlayerElement supporting HTTP, HLS, and DASH streams -->
        <MediaPlayerElement x:Name="PlayerWidget" 
                            AreTransportControlsEnabled="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>

        <!-- Optional Custom Overlay for Title / Back Navigation via Xbox Controller B Button -->
        <Grid VerticalAlignment="Top" Padding="48,27,48,27" Background="#B305060A">
            <TextBlock Text="{Binding MediaTitle}" 
                       Foreground="#FFFFFF" 
                       FontSize="24" 
                       FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Page>