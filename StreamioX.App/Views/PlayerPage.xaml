<Page
    x:Class="StreamioX.App.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#05060A"
    XYFocusKeyboardNavigation="Enabled">

    <Grid Background="#05060A">
        <MediaPlayerElement x:Name="PlayerWidget"
                            AreTransportControlsEnabled="True"
                            AutoPlay="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"/>

        <Grid VerticalAlignment="Top" Padding="48,27,48,27" Background="#B305060A">
            <StackPanel Spacing="5">
                <TextBlock Text="{Binding MediaTitle}" Foreground="#FFFFFF" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding PlaybackError}" Foreground="#FFFF9B8F" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
