<Page
    x:Class="StreamioX.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <Grid Padding="48,27,48,27">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" Foreground="White" FontSize="36" FontWeight="SemiBold" Margin="0,0,0,32"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">

                <!-- Account / QR login -->
                <TextBlock Text="Stremio Account" Foreground="#A78BFA" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <Grid Background="#1A1B26" CornerRadius="8" Padding="24" Margin="0,0,0,32">
                    <StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.AccountLabel, Mode=OneWay}" Foreground="White" FontSize="18" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Content="Sign in with QR" Click="StartQr_Click" Margin="0,0,12,0"/>
                            <Button Content="Cancel" Click="CancelQr_Click" Margin="0,0,12,0"/>
                            <Button Content="Sign out" Click="Logout_Click"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Image Width="200" Height="200" Source="{x:Bind ViewModel.QrImage, Mode=OneWay}" Stretch="Uniform" Margin="0,0,24,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Code" Foreground="#888" FontSize="14"/>
                                <TextBlock Text="{x:Bind ViewModel.LinkCode, Mode=OneWay}" Foreground="White" FontSize="40" FontWeight="Bold" Margin="0,4,0,12"/>
                                <TextBlock Text="{x:Bind ViewModel.LinkUrl, Mode=OneWay}" Foreground="#888" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="Scan the QR with your phone, or open the link and enter the code while logged into Stremio." Foreground="#AAA" FontSize="14" TextWrapping="Wrap" MaxWidth="400" Margin="0,12,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.AuthStatusMessage, Mode=OneWay}" Foreground="#FFB74D" TextWrapping="Wrap" Margin="0,8,0,16"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Sync account add-ons" Click="SyncAccountAddons_Click"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.AddonSyncStatus, Mode=OneWay}" Foreground="#A78BFA" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <TextBlock Text="Or email / password" Foreground="#888" Margin="0,8,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="EmailBox" Width="260" PlaceholderText="Email" Margin="0,0,8,0"/>
                            <PasswordBox x:Name="PasswordBox" Width="200" PlaceholderText="Password" Margin="0,0,8,0"/>
                            <Button Content="Sign in" Click="EmailLogin_Click"/>
                        </StackPanel>

                        <TextBlock Text="Or paste auth key (from web.stremio.com profile)" Foreground="#888" Margin="0,12,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="AuthKeyBox" Width="480" PlaceholderText="authKey" Margin="0,0,8,0"/>
                            <Button Content="Use key" Click="AuthKeyLogin_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Playback Server" Foreground="#A78BFA" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <Grid Background="#1A1B26" CornerRadius="8" Padding="24" Margin="0,0,0,32">
                    <StackPanel>
                        <TextBlock Text="Connect to an HTTP media server" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Enter the full address of a video or stream hosted on your network or online. Example: http://192.168.1.20:8080/movies/video.mp4" Foreground="#AAA" TextWrapping="Wrap" MaxWidth="780" Margin="0,0,0,16"/>
                        <TextBox Text="{x:Bind ViewModel.PlaybackServerAddress, Mode=TwoWay}" PlaceholderText="http://server-address:port/path/video.mp4" MinWidth="600" MaxWidth="780" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                        <Button Content="Connect &amp; Play" Command="{x:Bind ViewModel.ConnectPlaybackServerCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                        <TextBlock Text="{x:Bind ViewModel.PlaybackServerStatus, Mode=OneWay}" Foreground="White" TextWrapping="Wrap" MaxWidth="780"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Torrent HTTP Streaming" Foreground="#A78BFA" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <Grid Background="#1A1B26" CornerRadius="8" Padding="24" Margin="0,0,0,32">
                    <StackPanel>
                        <TextBlock Text="Local range server" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Serves torrent files over HTTP for the Xbox media player. The local HTTP adapter handles byte-range requests (206), seeks to the requested file offset, and reads the matching data through Stremio EngineFS backed by librqbit." Foreground="#AAA" TextWrapping="Wrap" MaxWidth="780" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="Start server" Command="{x:Bind ViewModel.StartTorrentServerCommand}" Margin="0,0,12,0"/>
                            <Button Content="Stop server" Command="{x:Bind ViewModel.StopTorrentServerCommand}" IsEnabled="{x:Bind ViewModel.IsTorrentServerRunning, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Status:" Foreground="#888" Width="110"/>
                            <TextBlock Text="{x:Bind ViewModel.TorrentServerStatus, Mode=OneWay}" Foreground="White" TextWrapping="Wrap" MaxWidth="650"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Local address:" Foreground="#888" Width="110"/>
                            <TextBlock Text="{x:Bind ViewModel.TorrentServerAddress, Mode=OneWay}" Foreground="#A78BFA"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Diagnostics" Foreground="#A78BFA" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
                <Grid Background="#1A1B26" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="System Hard Limit:" Foreground="#888" Width="180"/>
                            <TextBlock Text="{x:Bind ViewModel.SystemHardLimit, Mode=OneWay}" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Current Allocation:" Foreground="#888" Width="180"/>
                            <TextBlock Text="{x:Bind ViewModel.CurrentMemoryUsage, Mode=OneWay}" Foreground="#A78BFA" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="StremioX for Xbox" Foreground="White" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.AppVersionDisplay, Mode=OneWay}" Foreground="#888"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
