<Page
    x:Class="StreamioX.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <Grid Padding="48,27,48,27">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" Foreground="{StaticResource TextPrimaryBrush}" FontSize="36" FontWeight="SemiBold" Margin="0,0,0,32"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="32" MaxWidth="800" HorizontalAlignment="Left">
                <StackPanel Spacing="16">
                    <TextBlock Text="Diagnostics" Foreground="{StaticResource FocusAccentBrush}" FontSize="20" FontWeight="SemiBold"/>
                    <Grid Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="24">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="System Hard Limit:" Foreground="{StaticResource TextSecondaryBrush}" Width="180"/>
                                <TextBlock Text="{Binding SystemHardLimit}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="Current Allocation:" Foreground="{StaticResource TextSecondaryBrush}" Width="180"/>
                                <TextBlock Text="{Binding CurrentMemoryUsage}" Foreground="{StaticResource FocusAccentBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="StremioX for Xbox" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding AppVersionDisplay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>