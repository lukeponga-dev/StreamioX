<Page
    x:Class="StreamioX.App.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <Grid Padding="48,27,48,27">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="My Library" Foreground="{StaticResource TextPrimaryBrush}" FontSize="36" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" Margin="0,8,0,18"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="190" Margin="0,0,16,18">
                            <StackPanel Spacing="7">
                                <Button Click="OpenEntry_Click" Tag="{Binding}" Padding="0" Background="#171923" HorizontalContentAlignment="Stretch">
                                    <Grid Height="270">
                                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"/>
                                        <Border VerticalAlignment="Bottom" Background="#D910121A" Padding="9">
                                            <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
                                        </Border>
                                    </Grid>
                                </Button>
                                <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                <Button Content="Remove" Tag="{Binding}" Click="RemoveEntry_Click" HorizontalAlignment="Left" Padding="10,5" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <ProgressRing Grid.Row="2" IsActive="{Binding IsLoading}" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="{StaticResource FocusAccentBrush}"/>
    </Grid>
</Page>