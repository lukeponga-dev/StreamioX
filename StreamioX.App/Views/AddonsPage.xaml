<!-- Purpose: Defines the AddonsPage page layout and controller-focused visual structure. -->
<Page
    x:Class="StreamioX.App.Views.AddonsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:StreamioX.App.Models"
    Background="#05060A"
    x:Name="RootPage">
    <Grid Padding="48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Stremio Add-ons" Foreground="White" FontSize="32" FontWeight="SemiBold"/>
            <TextBlock Text="Install, synchronize and manage your Stremio-compatible providers."
                       Foreground="#A0A0A0" FontSize="14" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBox x:Name="ManifestUrlBox"
                     PlaceholderText="Add-on manifest URL (https://…/manifest.json)"
                     Width="560"
                     Text="{x:Bind ViewModel.ManifestUrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Install" Click="Install_Click" Margin="8,0,0,0"/>
            <Button Content="Sync all" Click="SyncAll_Click" Margin="8,0,0,0"/>
        </StackPanel>
        <ListView x:Name="AddonsList" Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Addons, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:InstalledAddon">
                    <Grid Padding="14,16" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind Name}" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind Description}" Foreground="#A0A0A0" TextWrapping="Wrap" MaxLines="2"/>
                            <TextBlock Text="{x:Bind BaseUrl}" Foreground="#707070" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="{x:Bind Version}" Foreground="#858585" FontSize="12"/>
                            <TextBlock Text="{x:Bind ResourcesDisplay}" Foreground="#B7B7B7" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind SyncState}" Foreground="#8D7BFF" FontSize="12"/>
                            <TextBlock Text="{x:Bind LastSyncedDisplay}" Foreground="#858585" FontSize="12"/>
                            <TextBlock Text="{x:Bind LastSyncError}" Foreground="#FF8A80" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Remove" VerticalAlignment="Center"
                                Click="Remove_Click" Tag="{x:Bind}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Foreground="#FFB74D" Margin="0,14,0,0" TextWrapping="Wrap"/>
    </Grid>
</Page>
