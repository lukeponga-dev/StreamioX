<Page
    x:Class="StreamioX.App.Views.AddonsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:StreamioX.App.Models"
    Background="#05060A"
    x:Name="RootPage">

    <Grid Padding="48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Stremio Addons"
                   Foreground="White"
                   FontSize="32"
                   FontWeight="SemiBold"
                   Margin="0,0,0,24"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal"   Margin="0,0,0,24">
            <TextBox x:Name="ManifestUrlBox"
                     PlaceholderText="https://v3-cinemeta.strem.io/manifest.json"
                     Width="560"
                     Text="{x:Bind ViewModel.ManifestUrlInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Install" Click="Install_Click"/>
            <Button Content="Refresh" Click="Refresh_Click"/>
        </StackPanel>

        <ListView x:Name="AddonsList"
                  Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Addons, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:InstalledAddon">
                    <Grid Padding="12,16" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Bind Name}" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind Description}" Foreground="#A0A0A0" TextWrapping="Wrap" MaxLines="2"/>
                            <TextBlock Text="{x:Bind BaseUrl}" Foreground="#707070" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Remove"
                                VerticalAlignment="Center"
                                Click="Remove_Click"
                                Tag="{x:Bind}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="3"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Foreground="#FFB74D"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Page>
