<Page
    x:Class="StreamioX.App.Views.DetailsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <Grid Padding="48,27,48,27">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="14" VerticalAlignment="Top">
            <Border CornerRadius="12" Height="420" Background="#171923">
                <Image x:Name="PosterImage" Stretch="UniformToFill"/>
            </Border>
            <TextBlock Text="{Binding ContentTypeText}" Foreground="{StaticResource FocusAccentBrush}" FontSize="13" FontWeight="Bold"/>
            <TextBlock Text="{Binding RatingText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16"/>
            <TextBlock Text="{Binding RuntimeText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1" Margin="32,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding TitleText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="36" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ReleaseText}" Foreground="{StaticResource FocusAccentBrush}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding GenreText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>

                <Button Content="{Binding LibraryButtonText}" Command="{Binding ToggleLibraryCommand}" HorizontalAlignment="Left" Padding="20,10" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Text="{Binding DescriptionText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" TextWrapping="Wrap" LineHeight="24"/>
                
                <StackPanel Spacing="8" Visibility="{Binding EpisodesVisibility, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="Episodes" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold"/>
                    <ListView ItemsSource="{Binding Episodes}" SelectionMode="None" IsItemClickEnabled="False" XYFocusKeyboardNavigation="Enabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Button Click="EpisodeButton_Click"
                                        Tag="{Binding}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Margin="0,3" Padding="14,10"
                                        Background="{StaticResource SurfaceBrush}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Overview}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" MaxHeight="42"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="Available Streams" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold"/>
                    <ProgressRing IsActive="{Binding IsLoadingStreams}" Width="20" Height="20" Foreground="{StaticResource FocusAccentBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFFF9B8F" TextWrapping="Wrap"/>
                <Border x:Name="StreamDetailsPanel" Background="#151725" BorderBrush="#4B4568" BorderThickness="1" CornerRadius="8" Padding="14" Visibility="Collapsed">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Selected source" Foreground="{StaticResource FocusAccentBrush}" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="StreamDetailsText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <ListView ItemsSource="{Binding Streams}" SelectionMode="None" XYFocusKeyboardNavigation="Enabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button Click="StreamButton_Click" GotFocus="StreamButton_GotFocus"
                                    Tag="{Binding}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Margin="0,4" Padding="16,12"
                                    Background="{StaticResource SurfaceBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SourceKind}" Foreground="{StaticResource FocusAccentBrush}" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
