<Page
    x:Class="StreamioX.App.Views.DetailsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:StreamioX.App.Helpers"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">
    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Padding="48,27,48,27">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="14" VerticalAlignment="Top">
            <Border CornerRadius="12" Height="420" Background="#171923">
                <Image x:Name="PosterImage" Stretch="UniformToFill"/>
            </Border>
            <TextBlock Text="{Binding ContentTypeText}" Foreground="{StaticResource FocusAccentBrush}" FontSize="13" FontWeight="Bold"/>
            <TextBlock Text="{Binding RatingText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16"/>
            <TextBlock Text="{Binding RuntimeText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1" Margin="32,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding TitleText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="36" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ReleaseText}" Foreground="{StaticResource FocusAccentBrush}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding GenreText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>

                <Button x:Name="LibraryButton" Content="{Binding LibraryButtonText}" Command="{Binding ToggleLibraryCommand}" HorizontalAlignment="Left" Padding="20,10" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" Style="{StaticResource XboxFocusCardStyle}"/>

                <TextBlock Text="{Binding DescriptionText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" TextWrapping="Wrap" LineHeight="24"/>
                
                <StackPanel x:Name="EpisodesSection" Spacing="8"
                            Visibility="{Binding IsSeries, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Episodes" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold"/>
                    <ScrollViewer HorizontalScrollMode="Enabled"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled"
                                  VerticalScrollBarVisibility="Disabled">
                        <controls:ItemsRepeater x:Name="EpisodesRepeater"
                                                ItemsSource="{Binding Episodes}">
                            <controls:ItemsRepeater.Layout>
                                <controls:StackLayout Orientation="Horizontal" Spacing="8"/>
                            </controls:ItemsRepeater.Layout>
                            <controls:ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding}"
                                            Click="EpisodeButton_Click"
                                            Width="320" Height="96"
                                            HorizontalContentAlignment="Left"
                                            Padding="16,12"
                                            Background="#161B25"
                                            BorderBrush="#394553"
                                            BorderThickness="1"
                                            Style="{StaticResource XboxFocusCardStyle}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Title, FallbackValue='Episode'}"
                                                       Foreground="White"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Overview}"
                                                       Foreground="#FFB9C2C9"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="48"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </controls:ItemsRepeater.ItemTemplate>
                        </controls:ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Text="Available Streams" Foreground="{StaticResource TextPrimaryBrush}" FontSize="22" FontWeight="SemiBold"/>
                    <ProgressRing IsActive="{Binding IsLoadingStreams}" Width="20" Height="20" Foreground="{StaticResource FocusAccentBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFFF9B8F" TextWrapping="Wrap"/>
                <Border x:Name="StreamDetailsPanel" Background="#151725" BorderBrush="#4B4568" BorderThickness="1" CornerRadius="8" Padding="14" Visibility="Collapsed">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Selected source" Foreground="{StaticResource FocusAccentBrush}" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="StreamDetailsText" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="StreamsRow" Spacing="8"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
