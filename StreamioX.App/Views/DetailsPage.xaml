<Page
    x:Class="StreamioX.App.Views.DetailsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <Grid Padding="48,27,48,27">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Poster Container -->
        <Border Grid.Column="0" CornerRadius="12" VerticalAlignment="Top" Height="450">
            <Image Source="{Binding SelectedMovie.PosterUrl}" Stretch="UniformToFill"/>
        </Border>

        <!-- Right Column: Title, Metadata, Overview & Stream List -->
        <ScrollViewer Grid.Column="1" Margin="32,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">

                <!-- Title & Year -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding SelectedMovie.Title}" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="36" 
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedMovie.ReleaseInfo}" 
                               Foreground="{StaticResource FocusAccentBrush}" 
                               FontSize="18" 
                               FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Plot Summary -->
                <TextBlock Text="{Binding SelectedMovie.Description}" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           FontSize="16" 
                           TextWrapping="Wrap" 
                           LineHeight="24"/>

                <Border Height="1" Background="#1AFFFFFF" Margin="0,8"/>

                <!-- Available Streams Section Header -->
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="Available Streams" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="22" 
                               FontWeight="SemiBold"/>
                    <ProgressRing IsActive="{Binding IsLoadingStreams}" Width="20" Height="20" Foreground="{StaticResource FocusAccentBrush}"/>
                </StackPanel>

                <!-- Streams List -->
                <ListView ItemsSource="{Binding Streams}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          XYFocusKeyboardNavigation="Enabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.PlayStreamCommand, ElementName=PageRoot}"
                                    CommandParameter="{Binding}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Margin="0,4"
                                    Padding="16,12"
                                    Background="{StaticResource SurfaceBrush}"
                                    CornerRadius="6">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>