<Page
    x:Class="StreamioX.App.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StreamioX.App.Controls"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <Grid Padding="48,27,48,27">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
            <TextBlock Text="Discover Catalogs"
                       Foreground="#FFFFFF"
                       FontSize="32"
                       FontWeight="SemiBold" />

            <ProgressRing IsActive="{Binding IsLoading}"
                          Width="24"
                          Height="24"
                          Margin="12,0,0,0"
                          Foreground="#7B5CFF" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <GridView
                x:Name="CatalogGrid"
                ItemsSource="{Binding Movies}"
                IsItemClickEnabled="True"
                IsTabStop="True"
                ItemClick="GridView_ItemClick"
                XYFocusKeyboardNavigation="Enabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="-1" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <controls:MediaCardControl Margin="12" />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>
    </Grid>
</Page>