<Page
    x:Class="StreamioX.App.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <!-- MainPage owns the TV safe-area padding; avoid applying it twice here. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="16"
            Margin="0,0,0,24">

            <TextBlock
                Text="Discover Catalogs"
                Foreground="White"
                FontSize="32"
                FontWeight="SemiBold"/>

            <ProgressRing
                IsActive="{Binding IsLoading}"
                Width="24"
                Height="24"
                Foreground="#7B5CFF"/>

        </StackPanel>

        <Grid Grid.Row="1">
            <TextBlock
                Text="{Binding ErrorMessage}"
                Foreground="#FF7777"
                FontSize="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <GridView
                x:Name="CatalogTestControl"
                Grid.Row="1"
                IsItemClickEnabled="True"
                SelectionMode="None"
                IsTabStop="True"
                TabNavigation="Once"
                HorizontalContentAlignment="Stretch"
                ItemClick="GridView_ItemClick">

                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            Orientation="Horizontal"
                            MaximumRowsOrColumns="6"
                            ItemWidth="176"
                            ItemHeight="250"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="160" Margin="8,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="220"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Image
                                Grid.Row="0"
                                Source="{Binding PosterUrl}"
                                Stretch="UniformToFill"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"/>

                            <TextBlock
                                Grid.Row="1"
                                Text="{Binding Title}"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="White"
                                TextWrapping="Wrap"
                                MaxLines="2"
                                Margin="0,7,0,0"/>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>

            </GridView>
        </Grid>
    </Grid>
</Page>