<Page
    x:Class="StreamioX.App.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <!-- MainPage owns the TV safe-area padding; avoid applying it twice here. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="16"
            Margin="0,0,0,24">

            <TextBlock
                Text="Discover Catalogs"
                Foreground="White"
                FontSize="32"
                FontWeight="SemiBold"/>

            <ProgressRing
                IsActive="{Binding IsLoading}"
                Width="24"
                Height="24"
                Foreground="#7B5CFF"/>

        </StackPanel>

        <TextBlock
            Grid.Row="0"
            Text="{Binding StatusMessage}"
            Foreground="#B9B2D0"
            FontSize="14"
            Margin="0,52,0,0"
            VerticalAlignment="Top"
            TextWrapping="Wrap"/>

        <Grid Grid.Row="1" MinHeight="400">
            <TextBlock
                Text="{Binding ErrorMessage}"
                Foreground="#FF7777"
                FontSize="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="900"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <ScrollViewer x:Name="CatalogGrid"
                          HorizontalScrollMode="Disabled"
                          VerticalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent">
                <!-- Use standard StackPanels for predictable UWP measurement.
                     WrapGrid is intended for ItemsControl.ItemsPanel, not direct ScrollViewer content. -->
                <StackPanel x:Name="CatalogRowsPanel"
                            Orientation="Vertical"
                            HorizontalAlignment="Stretch"
                            Spacing="12"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>