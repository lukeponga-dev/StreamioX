<!-- Purpose: Defines the DiscoverPage page layout and controller-focused visual structure. -->
<Page
    x:Class="StreamioX.App.Views.DiscoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:StreamioX.App.Models"
    Background="#0B0F14"
    RequestedTheme="Dark"
    XYFocusKeyboardNavigation="Enabled">

    <Page.Resources>
        <Style x:Key="PillFilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#181D2B" />
            <Setter Property="Foreground" Value="#D4D8E8" />
            <Setter Property="BorderBrush" Value="#252C3F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillRoot"
                                                Storyboard.TargetProperty="Opacity" To="0.88"
                                                Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillRoot"
                                                Storyboard.TargetProperty="Opacity" To="0.72"
                                                Duration="0:0:0.08" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PillRoot"
                                                Storyboard.TargetProperty="Opacity" To="1"
                                                Duration="0:0:0.12" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PosterGridItemStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,16,22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid x:Name="CardRoot" RenderTransformOrigin="0.5,0.42">
                            <Grid.RenderTransform>
                                <CompositeTransform x:Name="CardScale" />
                            </Grid.RenderTransform>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                Storyboard.TargetProperty="ScaleX" To="1"
                                                Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                Storyboard.TargetProperty="ScaleY" To="1"
                                                Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                Storyboard.TargetProperty="Opacity" To="0"
                                                Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="OuterGlow"
                                                Storyboard.TargetProperty="Opacity" To="0"
                                                Duration="0:0:0.14" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardRoot"
                                                Storyboard.TargetProperty="(Canvas.ZIndex)">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="0" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                Storyboard.TargetProperty="ScaleX" To="1.05"
                                                Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="CardScale"
                                                Storyboard.TargetProperty="ScaleY" To="1.05"
                                                Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="FocusRing"
                                                Storyboard.TargetProperty="Opacity" To="1"
                                                Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="OuterGlow"
                                                Storyboard.TargetProperty="Opacity" To="0.4"
                                                Duration="0:0:0.14" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardRoot"
                                                Storyboard.TargetProperty="(Canvas.ZIndex)">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="20" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Border x:Name="OuterGlow" Height="244"
                                    VerticalAlignment="Top" Margin="-4,-4,-4,0"
                                    CornerRadius="12" Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#557B5CFF" Offset="0"/>
                                        <GradientStop Color="#007B5CFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Border x:Name="FocusRing" Height="240"
                                    VerticalAlignment="Top" CornerRadius="8"
                                    BorderBrush="#A5B4FC" BorderThickness="2"
                                    Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Padding="48,20,48,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="Discover" FontSize="34" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center" />
                <Button x:Name="RefreshButton" Content="Refresh"
                        Style="{StaticResource PillFilterButtonStyle}"
                        Click="RetryButton_Click" />
                <ProgressRing IsActive="{Binding IsLoading}" Width="22" Height="22"
                              Foreground="#6366F1" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Browse movies and series" FontSize="15"
                       Foreground="#8E96AA" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10"
                    Margin="0,0,0,16" x:Name="ContentTypePanel" />

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Filter by genre" FontSize="14" FontWeight="SemiBold"
                       Foreground="#CBD5E1" Margin="0,0,0,9" />
            <Grid>
                <ScrollViewer x:Name="GenreScrollViewer"
                              HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              BringIntoViewOnFocusChange="True"
                              Padding="0,0,58,0">
                    <StackPanel x:Name="GenreChipsPanel" Orientation="Horizontal" Spacing="10" />
                </ScrollViewer>
                <Rectangle Width="64" HorizontalAlignment="Right" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#000B0F14" Offset="0" />
                            <GradientStop Color="#FF0B0F14" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
            <TextBlock x:Name="CountSummaryText" Text="0 movies · 0 series · 0 titles"
                       FontSize="13" Foreground="#6E778C" Margin="0,10,0,0" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8585"
                       FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="SectionTitleText" Grid.Row="0"
                       Text="All titles" FontSize="20" FontWeight="Bold"
                       Foreground="White" Margin="0,0,0,12" />
            <TextBlock x:Name="EmptyStateText" Grid.Row="1"
                       Text="No titles match this filter. Choose another type or genre."
                       Foreground="#9AA4B8" FontSize="17"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="520"
                       Visibility="Collapsed" />
            <GridView x:Name="CatalogGrid" Grid.Row="1"
                      ItemContainerStyle="{StaticResource PosterGridItemStyle}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="TitlesGridView_ItemClick"
                      Padding="4,6,4,28"
                      Background="Transparent"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollMode="Enabled"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      XYFocusUp="{x:Bind GenreScrollViewer}">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="10" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:Movie">
                        <StackPanel Width="166" Spacing="8">
                            <Border Width="166" Height="240" CornerRadius="8"
                                    Background="#151A26">
                                <Image Source="{x:Bind PosterUrl, Mode=OneWay}"
                                       Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{x:Bind Title}" FontSize="13"
                                       FontWeight="SemiBold" Foreground="#E2E8F0"
                                       MaxLines="2" TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap" Height="36" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
