<Page
    x:Class="StreamioX.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">
    <Page.Resources>
        <SolidColorBrush x:Key="CardSurface" Color="#10151B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#26333B"/>
        <SolidColorBrush x:Key="GreenAccent" Color="#20E66B"/>
        <DataTemplate x:Key="PosterTemplate">
            <Button Click="Poster_Click" Tag="{Binding}" Padding="0" Margin="0,0,12,0"
                    Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1" UseSystemFocusVisuals="True"
                    XYFocusKeyboardNavigation="Enabled">
                <Grid Width="132" Height="190" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="PosterScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                    <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"/>
                    <Border VerticalAlignment="Bottom" Background="#D900080D" Padding="7,8">
                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12"
                                   CharacterSpacing="110" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
            <StackPanel Spacing="16" Padding="0,6,0,28">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,0">
                    <TextBlock Text="Continue Watching" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
                    <ProgressRing IsActive="{Binding IsLoading}" Width="20" Height="20" Foreground="{StaticResource GreenAccent}"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled" IsTabStop="False">
                    <ItemsControl ItemsSource="{Binding ContinueWatching}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="Continue_Click" Tag="{Binding}" Padding="0" Background="#10151B"
                                        BorderBrush="#26333B" BorderThickness="1"
                                        XYFocusKeyboardNavigation="Enabled">
                                    <Grid Width="350" Height="174">
                                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"/>
                                        <Border Background="#99050A0D"/>
                                        <StackPanel VerticalAlignment="Bottom" Spacing="5" Margin="12">
                                            <TextBlock Text="{Binding DisplayTitle}" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ProgressText}" Foreground="#D0D9DC" FontSize="12"/>
                                            <ProgressBar Height="5" Maximum="100"
                                                Value="{Binding ProgressPercent}" Background="#455159" Foreground="{StaticResource GreenAccent}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="Popular Movies" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" IsTabStop="False">
                    <ItemsControl ItemsSource="{Binding PopularMovies}" ItemTemplate="{StaticResource PosterTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="Popular Series" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" IsTabStop="False">
                    <ItemsControl ItemsSource="{Binding PopularSeries}" ItemTemplate="{StaticResource PosterTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="Recommended For You" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" IsTabStop="False">
                    <ItemsControl ItemsSource="{Binding Recommended}" ItemTemplate="{StaticResource PosterTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="Recently Added" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" IsTabStop="False">
                    <ItemsControl ItemsSource="{Binding RecentlyAdded}" ItemTemplate="{StaticResource PosterTemplate}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{Binding StatusMessage}" Foreground="#8C9AA1" FontSize="12"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF9388" FontSize="14" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>