<Page
    x:Class="StreamioX.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <Grid Padding="48,27,48,27">
        <StackPanel Spacing="16">

            <TextBlock
                Text="Home"
                Foreground="#FFFFFF"
                FontSize="36"
                FontWeight="SemiBold"/>

            <TextBlock
                Text="{Binding WelcomeMessage}"
                Foreground="#A0A4B8"
                FontSize="20"/>

            <Button
                x:Name="ExploreDiscoverButton"
                Content="Explore Discover"
                MinWidth="220"
                MinHeight="56"
                HorizontalAlignment="Left"
                Click="ExploreDiscover_Click"/>

        </StackPanel>
    </Grid>
</Page>