<Page
    x:Class="StreamioX.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StreamioX.App.Controls"
    Background="Transparent"
    XYFocusKeyboardNavigation="Enabled">

    <!-- MainPage owns the TV safe-area padding; avoid applying it twice here. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24">

            <!-- Hero Featured Backdrop Component -->
            <controls:HeroBannerControl />

            <!-- Page Title & Subtitle -->
            <StackPanel Spacing="8">
                <TextBlock
                    Text="Home"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    FontSize="36"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Text="{Binding WelcomeMessage}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="20"/>
            </StackPanel>

            <!-- Navigation Action Button -->
            <Button
                x:Name="ExploreDiscoverButton"
                Content="Explore Discover"
                MinWidth="220"
                MinHeight="56"
                HorizontalAlignment="Left"
                Background="{StaticResource FocusAccentBrush}"
                Foreground="{StaticResource TextPrimaryBrush}"
                CornerRadius="6"
                Click="ExploreDiscover_Click"
                XYFocusKeyboardNavigation="Enabled"/>

        </StackPanel>
    </ScrollViewer>
</Page>